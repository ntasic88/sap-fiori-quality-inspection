{
  "name": "sap-fiori-quality-inspection",
  "version": "1.0.0",
  "description": "SAP Fiori Quality Inspection Management App with CAP Backend",
  "repository": "https://github.com/nicktasic/sap-fiori-quality-inspection",
  "license": "ISC",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "test": "node --localstorage-file /tmp/jest-ls node_modules/.bin/jest --forceExit"
  },
  "dependencies": {
    "@sap/cds": "^8",
    "@cap-js/sqlite": "^1",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8",
    "axios": "^1.13.6",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-subset": "^1.6.0",
    "jest": "^29"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": ":memory:"
        },
        "[production]": {
          "credentials": {
            "database": "db.sqlite"
          }
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "manager": {
            "password": "manager",
            "roles": [
              "QualityManager"
            ]
          },
          "inspector": {
            "password": "inspector",
            "roles": [
              "Inspector"
            ]
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
