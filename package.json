{
  "name": "sap-fiori-quality-inspection",
  "version": "1.0.0",
  "description": "SAP Fiori Quality Inspection Management App with CAP Backend",
  "repository": "https://github.com/nicktasic/sap-fiori-quality-inspection",
  "license": "ISC",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8",
    "@cap-js/sqlite": "^1"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": ":memory:"
        },
        "[production]": {
          "credentials": {
            "database": "db.sqlite"
          }
        }
      }
    }
  }
}
