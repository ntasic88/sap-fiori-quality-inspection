<mvc:View
    controllerName="qi.app.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <f:DynamicPage id="mainPage" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>mainTitle}" />
                </f:heading>
                <f:snappedContent>
                    <Text text="{i18n>appDescription}" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <HBox alignItems="End" wrap="Wrap">
                    <VBox class="sapUiSmallMarginEnd">
                        <Label text="{i18n>searchPlaceholder}" />
                        <SearchField
                            id="searchField"
                            width="20rem"
                            search=".onSearch"
                            liveChange=".onSearch" />
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd">
                        <Label text="{i18n>filterInspType}" />
                        <Select
                            id="inspTypeFilter"
                            change=".onFilterChange">
                            <core:Item key="All" text="{i18n>allTypes}" />
                            <core:Item key="01" text="Goods Receipt (01)" />
                            <core:Item key="04" text="Final Inspection (04)" />
                            <core:Item key="08" text="Recurring (08)" />
                            <core:Item key="09" text="Other (09)" />
                            <core:Item key="89" text="Stability Study (89)" />
                        </Select>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd">
                        <Label text="{i18n>filterPlant}" />
                        <Select
                            id="plantFilter"
                            change=".onFilterChange">
                            <core:Item key="All" text="{i18n>allPlants}" />
                            <core:Item key="1000" text="Plant 1000" />
                            <core:Item key="1010" text="Plant 1010" />
                            <core:Item key="1100" text="Plant 1100" />
                            <core:Item key="1710" text="Plant 1710" />
                        </Select>
                    </VBox>
                    <VBox class="sapUiSmallMarginEnd">
                        <Label text="{i18n>filterStatus}" />
                        <Select
                            id="statusFilter"
                            change=".onFilterChange">
                            <core:Item key="All" text="{i18n>allStatuses}" />
                            <core:Item key="Open" text="{i18n>statusOpen}" />
                            <core:Item key="DecisionMade" text="{i18n>statusDecisionMade}" />
                        </Select>
                    </VBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
                    <Table
                        id="inspectionTable"
                        items="{
                            path: '/Inspections',
                            parameters: { $count: true },
                            sorter: { path: 'InspectionLotID', descending: true }
                        }"
                        growing="true"
                        growingThreshold="25"
                        mode="SingleSelectMaster"
                        selectionChange=".onItemPress"
                        sticky="ColumnHeaders,HeaderToolbar"
                        alternateRowColors="true"
                        popinLayout="GridSmall">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{i18n>mainCount}" />
                                <ToolbarSpacer />
                                <Button
                                    icon="sap-icon://sort"
                                    tooltip="{i18n>sortTooltip}"
                                    press=".onSort"
                                    type="Transparent" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column width="10rem">
                                <Text text="{i18n>columnLotID}" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="{i18n>columnDescription}" />
                            </Column>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="{i18n>columnMaterial}" />
                            </Column>
                            <Column width="6rem" hAlign="Center" minScreenWidth="Tablet" demandPopin="true">
                                <Text text="{i18n>columnPlant}" />
                            </Column>
                            <Column width="10rem" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="{i18n>columnInspectionType}" />
                            </Column>
                            <Column width="9rem" hAlign="Center">
                                <Text text="{i18n>columnStatus}" />
                            </Column>
                            <Column width="10rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                <Text text="{i18n>columnQuantity}" />
                            </Column>
                            <Column width="9rem" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="{i18n>columnDate}" />
                            </Column>
                            <Column width="8rem" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="{i18n>columnBatch}" />
                            </Column>
                            <Column width="8rem" minScreenWidth="Desktop" demandPopin="true">
                                <Text text="{i18n>columnSupplier}" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem type="Navigation">
                                <cells>
                                    <ObjectIdentifier
                                        title="{InspectionLotID}"
                                        text="{
                                            path: 'CreatedDate',
                                            formatter: '.formatter.formatDate'
                                        }" />
                                    <Text text="{MaterialDescription}" />
                                    <Text text="{MaterialNumber}" />
                                    <Text text="{Plant}" />
                                    <HBox alignItems="Center">
                                        <core:Icon
                                            src="{
                                                path: 'InspectionType',
                                                formatter: '.formatter.inspectionTypeIcon'
                                            }"
                                            class="sapUiTinyMarginEnd"
                                            size="1rem"
                                            color="Default" />
                                        <Text text="{
                                            path: 'InspectionType',
                                            formatter: '.formatter.inspectionTypeText'
                                        }" />
                                    </HBox>
                                    <ObjectStatus
                                        text="{
                                            path: 'HasUsageDecision',
                                            formatter: '.formatter.statusText'
                                        }"
                                        state="{
                                            path: 'HasUsageDecision',
                                            formatter: '.formatter.statusState'
                                        }"
                                        icon="{
                                            path: 'HasUsageDecision',
                                            formatter: '.formatter.statusIcon'
                                        }" />
                                    <Text text="{
                                        parts: ['Quantity', 'UnitOfMeasure'],
                                        formatter: '.formatter.formatQuantityWithUnit'
                                    }" />
                                    <Text text="{
                                        path: 'CreatedDate',
                                        formatter: '.formatter.formatDate'
                                    }" />
                                    <Text text="{BatchNumber}" />
                                    <Text text="{Supplier}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
